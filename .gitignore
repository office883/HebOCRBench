# These paths are excluded from ordinary Git history because Git is not the
# distribution layer for immutable multi-GB benchmark payloads. They remain
# first-class HebOCRBench sources/artifacts and are delivered through Releases,
# object storage, Git LFS where suitable, or pinned federated acquisition.
.hebocrbench-cache/
corpus/
corpora-materialized/
datasets/
builds/
release-packs/
organizer-pack/
participant-pack/
source-snapshots/
artifacts/
baseline-runs/

# Hidden-test and organizer secrets must never enter the public repository.
organizer-secret*
*hmac-key*
*.secret
.env
.env.*

# Release products are attached to versioned releases, not committed as blobs.
*.whl
*.tar.gz
*.tar.xz
*.tgz
*.zip
*.bundle
SBOM*.json
SHA256SUMS*
CERTIFIED*
FROZEN*

# Temporary import/bootstrap transports are forbidden on release branches.
.bootstrap/
*.b64.part*
transfer-trigger.txt