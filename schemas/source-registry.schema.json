{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebocrbench.org/schema/source-registry-1.0.json",
  "title": "HebOCRBench Source Registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/source"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "download": {
      "type": "object",
      "required": ["kind", "url"],
      "properties": {
        "kind": {"enum": ["http", "git", "api", "bundled"]},
        "url": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "md5": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "required": ["expression", "class", "authority", "requires_acceptance", "attribution"],
      "properties": {
        "expression": {"type": "string", "minLength": 1},
        "class": {"enum": ["bundled", "permissive", "share_alike", "noncommercial_sharealike", "no_derivatives", "per_item", "unknown"]},
        "authority": {"type": "string", "minLength": 1},
        "requires_acceptance": {"type": "boolean"},
        "attribution": {"type": "string", "minLength": 1},
        "restrictions": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "version", "task", "languages", "script", "role", "status", "format", "primary_score", "landing_page", "downloads", "license", "expected"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "task": {"enum": ["page_ocr", "page_transcription", "line_recognition", "character_recognition", "diagnostic"]},
        "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "script": {"type": "string", "minLength": 4},
        "role": {"enum": ["core", "supplemental", "diagnostic", "candidate", "rejected"]},
        "status": {"enum": ["available", "api", "bundled", "candidate", "rejected"]},
        "format": {"type": "string", "minLength": 1},
        "primary_score": {"type": "boolean"},
        "landing_page": {"type": "string", "minLength": 1},
        "downloads": {"type": "array", "items": {"$ref": "#/$defs/download"}},
        "license": {"$ref": "#/$defs/license"},
        "expected": {"type": "object"},
        "split_policy": {"type": "string"},
        "importer": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "citations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
