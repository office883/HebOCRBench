{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebocrbench.org/schema/corpus-manifest-1.0.json",
  "title": "HebOCRBench Corpus Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "benchmark_version",
    "profile",
    "dataset_fingerprint",
    "registry_fingerprint",
    "page_count",
    "source_ids",
    "license_tiers",
    "stats",
    "audit",
    "files",
    "accepted_source_ids",
    "source_verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark": {
      "const": "HebOCRBench"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "profile_scope": {
      "enum": [
        "full",
        "track-component"
      ]
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_dataset_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "derivation": {
      "type": "object",
      "additionalProperties": true
    },
    "dataset_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "license_tiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stats": {
      "type": "object"
    },
    "audit": {
      "type": "object",
      "required": [
        "is_valid",
        "errors",
        "warnings"
      ],
      "properties": {
        "is_valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "accepted_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_verification": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_id",
          "verification_status",
          "required_artifact_ids",
          "artifacts",
          "problems"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
